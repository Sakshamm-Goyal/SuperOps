# SITE_ADDRESS: a domain (e.g. superops.example.com) gets automatic HTTPS; ":80" serves plain HTTP (local/IP only).
{$SITE_ADDRESS::80} {
	encode gzip
	@api path /v1/* /health/* /docs /openapi.json
	handle @api {
		reverse_proxy api:8000
	}
	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
	header -Server
}
