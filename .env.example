# SuperOps configuration. Copy to .env (git-ignored) and fill in. Never commit real values.
APP_ENV=sandbox                       # sandbox (local) | hosted (docs/openapi require operator auth)
RUNTIME_MODE=sample                   # sample | connected_demo | replay  — server policy, never a browser toggle
TENANT_ID=sandbox-tenant
DATABASE_URL=postgresql://greenops@127.0.0.1:55432/greenops_app
POSTGRES_PASSWORD=                    # Docker Compose only: password for the db container
SAMPLE_SOURCE_URL=postgresql://greenops@127.0.0.1:55432/greenops_sample_src   # sample mode only (NOT federation)

# --- Zetaris (connected_demo): public SaaS OpenAPI v1; confirm your workspace's base URL and auth profile
ZETARIS_API_BASE_URL=https://api.saas.enterprise.zetaris.com
ZETARIS_ORG_ID=                       # int64 X-Org-ID
ZETARIS_AUTH_MODE=                    # api_key | login_id_token  (pick the ONE profile your workspace documents)
ZETARIS_API_KEY=                      # console API key used as Bearer (api_key mode)
ZETARIS_USERNAME=                     # login_id_token mode: Basic login → idToken Bearer
ZETARIS_PASSWORD=
ZETARIS_PAGE_LIMIT=100
ZETARIS_SOURCE_CLOUD=                 # e.g. cloud_pg.public   (physical source A: inventory, telemetry, billing)
ZETARIS_SOURCE_REF=                   # e.g. cloud_pg.ref      (prices, policies, carbon factors; may live on source A or a file source)
ZETARIS_SOURCE_AI=                    # e.g. ai_pg.public      (physical source B: AI runs/calls) — must differ from SOURCE_CLOUD's datasource

# --- NVIDIA model (OpenAI-compatible hosted API) used through Google ADK + LiteLLM
MODEL_BASE_URL=https://integrate.api.nvidia.com/v1
MODEL_ID=nvidia/nemotron-3.5-super-vl-120b-a12b   # verified available 25 Oct 2026 (GET /v1/models)
MODEL_API_KEY=
MODEL_STRUCTURED_OUTPUT=json_schema   # json_schema | prompt (if the endpoint rejects response_format)
MODEL_ROLE_TIMEOUT_S=90                # per-turn ceiling for one agent role call
MODEL_MAX_OUTPUT_TOKENS=4096          # per-request generation ceiling; must fit the largest schema-valid role output
MODEL_REASONING=off                   # on: Nemotron thinking (reasoning tokens count against MODEL_MAX_OUTPUT_TOKENS)
EVALUATOR_MODEL_API_KEY=              # separate credential for the holdout evaluator (role D)

# --- Meterless H-MEM sidecar (memory-sidecar/)
MEMORY_BASE_URL=http://127.0.0.1:7410
MEMORY_AUTH_TOKEN=                    # >=16 chars, private
HMEM_DATA_DIR=var/hmem                # durable directory
EMBEDDING_MODE=nvidia                 # nvidia (connected) | hash_conformance (deterministic tests/sample only; semantic=false)
EMBEDDING_BASE_URL=https://integrate.api.nvidia.com/v1
EMBEDDING_MODEL_ID=nvidia/nemotron-3.5-embed-1b
EMBEDDING_API_KEY=

# --- Execution and budgets
SANDBOX_WRITES_ENABLED=false          # enable only after review; still requires a plan-bound approval
ALLOWED_TARGET_IDS=local/sandbox/support-worker-stg,local/sandbox/support-ai-workflow
SANDBOX_DIR=var/sandbox
POLICY_VERSION=pol-v1                 # changing it invalidates prior trials/approvals and makes memories historical
DATA_MANIFEST_ID=support-demo-data-v1
MAX_RUN_COST_USD=                     # required in connected_demo; no cap => BUDGET_NOT_CONFIGURED
MAX_MODEL_CALLS_PER_RUN=400
MAX_TRIAL_SECONDS=900
EVALUATOR_DIR=.evaluator              # evaluator-only holdout storage (git-ignored)

# --- Ops Copilot (advisory chat over read-only tools; never authorizes anything)
ANTHROPIC_API_KEY=
COPILOT_MODEL_ID=claude-haiku-4-5-20251001
